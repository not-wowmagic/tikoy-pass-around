    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "tikoy-pass-around.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "tikoy-pass-around",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "tikoy-pass-around.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "419582472336",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:419582472336:web:092405e4185d02a98d2815",
    "NEXT_PUBLIC_SITE_URL": "https://tikoy-pass-around.gmawong10.workers.dev"
